{
  "expo": {
    "name": "LifeDesk",
    "slug": "lifedesk",
    "scheme": "lifedesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brain-dump-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enzizy.lifedesk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/brain-dump-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.enzizy.lifedesk"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brain-dump-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brain-dump-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LifeDesk to record your voice notes."
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LifeDesk to select images for local conversion, compression, and resizing.",
          "cameraPermission": "Allow LifeDesk to use the camera for AR measurements.",
          "microphonePermission": "Allow LifeDesk to record your voice notes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow LifeDesk to save processed images to your photo library.",
          "granularPermissions": []
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "f8eafeb4-f17e-4af9-a778-8662d1b0fe22"
      }
    },
    "owner": "enzizyy"
  }
}
