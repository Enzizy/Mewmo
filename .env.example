# Mobile app: use your computer's LAN address when testing on a physical phone.
# Example: http://192.168.1.25:8787
EXPO_PUBLIC_LIFEDESK_API_URL=http://192.168.1.25:8787

# Use the same long random value in the app and backend. This protects a personal
# deployment from anonymous requests, but it is still embedded in the installed app.
EXPO_PUBLIC_LIFEDESK_CLIENT_TOKEN=replace_with_a_long_random_value
LIFEDESK_CLIENT_TOKEN=replace_with_the_same_long_random_value

# Existing MEWMO_* variables are still accepted for backward compatibility.

# Backend only. Never prefix this with EXPO_PUBLIC_ or include it in the app.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
# Optional free personal-use market quotes for BTC, VOO, and USD/PHP.
# Create a Basic key at https://twelvedata.com/
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_key
PORT=8787
ALLOWED_ORIGIN=*
